{
  "xsappname": "mvp-app",
  "scopes": [
    {
      "name": "$XSAPPNAME.Viewer",
      "description": "Lectura del MVP"
    },
    {
      "name": "$XSAPPNAME.Editor",
      "description": "Lectura y escritura del MVP"
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
